<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Pelotão Esperança</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="app-layout"><aside class="sidebar"><a class="brand" href="/admin"><span class="brand-mark">PE</span><span>Pelotão Esperança</span></a><div class="side-label">ESPAÇO DO PROFESSOR</div><a class="nav-link" href="/admin"><span>▦</span> Visão geral</a><a class="nav-link active" href="/admin/atividades/<%= activity.id %>"><span>▤</span> Entregas</a><div class="sidebar-bottom"><div class="profile-mini"><div class="avatar">P</div><div><strong><%= user.username %></strong><small>Professor · Root</small></div></div><form method="post" action="/logout"><button class="nav-link logout" type="submit"><span>↗</span> Sair da conta</button></form></div></aside><main class="main-content"><header class="topbar"><div><div class="breadcrumb"><a href="/admin">Painel</a> <span>/</span> Entregas</div><h1><%= activity.title %></h1><p class="muted"><%= activity.description %></p></div><a class="btn btn-soft" href="/admin">← Voltar ao painel</a></header><% if (notice) { %><div class="notice <%= notice.type %>"><%= notice.message %></div><% } %><section class="panel"><div class="section-heading"><div><span class="eyebrow">CORREÇÃO E AVALIAÇÃO</span><h2>Entregas dos alunos</h2><p class="muted">Abra cada arquivo e registre a nota de 0 a 100.</p></div><span class="count-pill"><%= submissions.length %></span></div><% if (!submissions.length) { %><div class="empty-state"><div class="empty-icon">↥</div><strong>Nenhuma entrega por enquanto</strong><p>Os arquivos enviados pelos alunos aparecerão aqui.</p></div><% } else { %><div class="submission-list"><% submissions.forEach(s => { %><article class="submission-row"><div class="student-cell submission-student"><span class="avatar student-avatar"><%= s.username.charAt(0).toUpperCase() %></span><div><strong><%= s.full_name || s.username %></strong><small>@<%= s.username %> · Turma da <%= s.class_name === 'manha' ? 'manhã' : 'tarde' %></small><small>Enviado em <%= new Date(s.submitted_at).toLocaleString('pt-BR', {dateStyle:'short',timeStyle:'short'}) %></small></div></div><a class="file-download" href="/admin/envios/<%= s.id %>/arquivo"><span class="file-icon">↓</span><span><strong><%= s.original_name %></strong><small>Baixar arquivo</small></span></a><form class="grade-form" action="/admin/envios/<%= s.id %>/nota" method="post"><label>Nota <span class="muted">/ 100</span><input type="number" name="grade" min="0" max="100" step="0.01" value="<%= s.grade === null ? '' : Number(s.grade) %>" placeholder="—"></label><label class="feedback-label">Feedback (opcional)<input name="feedback" maxlength="1000" value="<%= s.feedback || '' %>" placeholder="Comentário para o aluno"></label><button class="btn btn-primary" type="submit">Salvar nota</button></form><% if (s.grade !== null) { %><span class="status status-graded">Nota: <%= Number(s.grade).toLocaleString('pt-BR', {maximumFractionDigits:2}) %></span><% } %></article><% }) %></div><% } %></section><footer class="page-footer">Pelotão Esperança <span>·</span> Correções e entregas</footer></main></div></body></html>
