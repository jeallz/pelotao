
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Pelotão Esperança</title>
  <link rel="stylesheet" href="/css/style.css">
  <script defer src="/js/app.js"></script>
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <a class="brand brand-text" href="/admin">Pelotão Esperança</a>

      <div class="side-label">ESPAÇO DO PROFESSOR</div>

      <a class="nav-link active" href="/admin">
        <span>▦</span> Visão geral
      </a>
      <a class="nav-link" href="#criar">
        <span>＋</span> Nova atividade
      </a>
      <a class="nav-link" href="#alunos">
        <span>♙</span> Alunos e ranking
      </a>

      <div class="sidebar-bottom">
        <div class="profile-mini">
          <div class="avatar">P</div>
          <div>
            <strong><%= user.username %></strong>
            <small>Professor · Root</small>
          </div>
        </div>

        <form method="post" action="/logout">
          <button class="nav-link logout" type="submit">
            <span>↗</span> Sair da conta
          </button>
        </form>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <div class="breadcrumb">Painel <span>/</span> Visão geral</div>
          <h1>Bom trabalho, professor <span class="wave">✦</span></h1>
          <p class="muted">Aqui está o resumo das suas turmas.</p>
        </div>
        <a class="btn btn-soft" href="/ranking">♜ Ver ranking</a>
      </header>

      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="notice <%= notice.type %>">
          <%= notice.message %>
        </div>
      <% } %>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon purple">♙</div>
          <span>Alunos cadastrados</span>
          <strong><%= counts.students %></strong>
          <small>nas duas turmas</small>
        </div>

        <div class="stat-card">
          <div class="stat-icon blue">▤</div>
          <span>Atividades criadas</span>
          <strong><%= counts.activities %></strong>
          <small>no total</small>
        </div>

        <div class="stat-card">
          <div class="stat-icon orange">↥</div>
          <span>Entregas recebidas</span>
          <strong><%= counts.submissions %></strong>
          <small>arquivos enviados</small>
        </div>

        <div class="stat-card">
          <div class="stat-icon green">✓</div>
          <span>Notas lançadas</span>
          <strong><%= counts.graded %></strong>
          <small>avaliações concluídas</small>
        </div>
      </section>

      <div class="content-grid">
        <section class="panel" id="criar">
          <div class="section-heading">
            <div>
              <span class="eyebrow">PUBLICAR CONTEÚDO</span>
              <h2>Criar atividade</h2>
              <p class="muted">Escolha para qual turma publicar.</p>
            </div>
            <span class="heading-icon">＋</span>
          </div>

          <form action="/admin/atividades" method="post" class="form-stack">
            <label>
              Turma
              <select name="class_name" required>
                <option value="manha">Manhã</option>
                <option value="tarde">Tarde</option>
              </select>
            </label>

            <label>
              Título da atividade
              <input
                name="title"
                required
                minlength="3"
                maxlength="140"
                placeholder="Ex.: Projeto final — etapa 1"
              >
            </label>

            <label>
              Descrição e instruções
              <textarea
                name="description"
                required
                minlength="3"
                rows="5"
                maxlength="10000"
                placeholder="Explique o que os alunos precisam fazer..."
              ></textarea>
            </label>

            <label>
              Prazo de entrega
              <span class="optional">(opcional)</span>
              <input type="datetime-local" name="due_date">
            </label>

            <button class="btn btn-primary" type="submit">
              Publicar atividade <span>→</span>
            </button>
          </form>
        </section>

        <section class="panel activity-panel">
          <div class="section-heading">
            <div>
              <span class="eyebrow">ACOMPANHAMENTO</span>
              <h2>Suas atividades</h2>
              <p class="muted">Acesse as entregas e lance as notas.</p>
            </div>
            <span class="count-pill"><%= activities.length %></span>
          </div>

          <% if (!activities.length) { %>
            <div class="empty-state">
              <div class="empty-icon">▤</div>
              <strong>Nenhuma atividade ainda</strong>
              <p>Crie sua primeira atividade usando o formulário ao lado.</p>
            </div>
          <% } else { %>
            <div class="activity-list">
              <% activities.forEach(a => { %>
                <article class="activity-item">
                  <div class="activity-symbol">▤</div>

                  <div class="activity-info">
                    <a class="activity-title" href="/admin/atividades/<%= a.id %>">
                      <%= a.title %>
                    </a>

                    <small>
                      <%= a.class_name === 'manha' ? 'Turma da manhã' : 'Turma da tarde' %>
                      ·
                      <%= a.due_date
                        ? ('Prazo: ' + new Date(a.due_date).toLocaleString('pt-BR', {
                            dateStyle: 'short',
                            timeStyle: 'short'
                          }))
                        : 'Sem prazo definido'
                      %>
                    </small>

                    <div class="progress-meta">
                      <span><%= a.submission_count %> entrega(s)</span>
                      <span><%= a.graded_count %> nota(s)</span>
                    </div>

                    <div class="progress-track">
                      <span style="width: <%= a.submission_count
                        ? Math.min(100, a.graded_count / a.submission_count * 100)
                        : 0 %>%"></span>
                    </div>
                  </div>

                  <a
                    class="icon-button"
                    href="/admin/atividades/<%= a.id %>"
                    aria-label="Ver entregas"
                  >→</a>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </div>

      <%
        const rankingManha =
          typeof studentsManha !== 'undefined' && Array.isArray(studentsManha)
            ? studentsManha
            : (typeof students !== 'undefined' && Array.isArray(students)
                ? students
                : []);

        const rankingTarde =
          typeof studentsTarde !== 'undefined' && Array.isArray(studentsTarde)
            ? studentsTarde
            : [];
      %>

      <!-- RANKING DA MANHÃ -->
      <section class="panel ranking-panel" id="alunos">
        <div class="section-heading">
          <div>
            <span class="eyebrow">DESEMPENHO DA TURMA</span>
            <h2>Ranking — manhã</h2>
            <p class="muted">Soma das notas dos alunos da turma da manhã.</p>
          </div>

          <a class="text-link" href="/ranking?turma=manha">
            Ver completo →
          </a>
        </div>

        <% if (!rankingManha.length) { %>
          <div class="empty-state compact">
            <strong>Nenhum aluno na turma da manhã</strong>
            <p>Os alunos cadastrados nessa turma aparecerão aqui.</p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Posição</th>
                  <th>Aluno</th>
                  <th>Atividades avaliadas</th>
                  <th>Pontuação total</th>
                </tr>
              </thead>

              <tbody>
                <% rankingManha.slice(0, 6).forEach((s, i) => { %>
                  <tr>
                    <td>
                      <span class="rank-number <%= i < 3 ? 'top-rank' : '' %>">
                        <%= i + 1 %>
                      </span>
                    </td>

                    <td>
                      <div class="student-cell">
                        <span class="avatar student-avatar">
                          <%= (s.username || '?').charAt(0).toUpperCase() %>
                        </span>
                        <div>
                          <strong><%= s.full_name || s.username %></strong>
                          <small>@<%= s.username %></small>
                        </div>
                      </div>
                    </td>

                    <td><%= s.graded_count %></td>

                    <td>
                      <strong class="score">
                        <%= Number(s.total_score || 0).toLocaleString('pt-BR', {
                          maximumFractionDigits: 2
                        }) %>
                      </strong>
                      <span class="muted">pts</span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <!-- RANKING DA TARDE -->
      <section class="panel ranking-panel ranking-panel-secondary" id="ranking-tarde">
        <div class="section-heading">
          <div>
            <span class="eyebrow">DESEMPENHO DA TURMA</span>
            <h2>Ranking — tarde</h2>
            <p class="muted">Soma das notas dos alunos da turma da tarde.</p>
          </div>

          <a class="text-link" href="/ranking?turma=tarde">
            Ver completo →
          </a>
        </div>

        <% if (!rankingTarde.length) { %>
          <div class="empty-state compact">
            <strong>Nenhum aluno na turma da tarde</strong>
            <p>Os alunos cadastrados nessa turma aparecerão aqui.</p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Posição</th>
                  <th>Aluno</th>
                  <th>Atividades avaliadas</th>
                  <th>Pontuação total</th>
                </tr>
              </thead>

              <tbody>
                <% rankingTarde.slice(0, 6).forEach((s, i) => { %>
                  <tr>
                    <td>
                      <span class="rank-number <%= i < 3 ? 'top-rank' : '' %>">
                        <%= i + 1 %>
                      </span>
                    </td>

                    <td>
                      <div class="student-cell">
                        <span class="avatar student-avatar">
                          <%= (s.username || '?').charAt(0).toUpperCase() %>
                        </span>
                        <div>
                          <strong><%= s.full_name || s.username %></strong>
                          <small>@<%= s.username %></small>
                        </div>
                      </div>
                    </td>

                    <td><%= s.graded_count %></td>

                    <td>
                      <strong class="score">
                        <%= Number(s.total_score || 0).toLocaleString('pt-BR', {
                          maximumFractionDigits: 2
                        }) %>
                      </strong>
                      <span class="muted">pts</span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <footer class="page-footer">
        Pelotão Esperança <span>·</span> Portal de atividades.
      </footer>
    </main>
  </div>
</body>
</html>
